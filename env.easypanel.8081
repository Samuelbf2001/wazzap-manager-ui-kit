# Variables de Entorno para EasyPanel - Puerto 8081
# WhatsApp Manager UI Kit

# ===========================================
# CONFIGURACIÓN EVOLUTION API
# ===========================================
EVOLUTION_API_URL=https://tu-evolution-api.easypanel.host
EVOLUTION_API_KEY=tu-api-key-segura-aqui

# ===========================================
# CONFIGURACIÓN HUBSPOT (OPCIONAL)
# ===========================================
HUBSPOT_API_KEY=tu-hubspot-key-aqui
HUBSPOT_PORTAL_ID=tu-portal-id-aqui

# ===========================================
# URLs DE PRODUCCIÓN
# ===========================================
PRODUCTION_URL=https://tu-dominio.easypanel.host
WEBHOOK_URL=https://tu-dominio.easypanel.host/api/webhook

# ===========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===========================================
VITE_APP_TITLE=WhatsApp Manager UI Kit
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Gestión profesional de WhatsApp Business

# ===========================================
# CONFIGURACIÓN NODE - PUERTO 8081
# ===========================================
NODE_ENV=production
PORT=8081

# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS (SI NECESARIAS)
# ===========================================
# DATABASE_URL=postgresql://usuario:password@host:puerto/database
# REDIS_URL=redis://usuario:password@host:puerto

# ===========================================
# CONFIGURACIÓN DE LOGS
# ===========================================
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=true

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# - Puerto cambiado a 8081 para evitar conflictos
# - Asegúrate de configurar el puerto 8081 en EasyPanel
# - Verifica que no haya otros servicios usando el puerto 8081
